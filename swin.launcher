#!/bin/bash

#SBATCH -J swin_softmax           # Job name
#SBATCH -o swin_imagenet.%j.out         # Name of stdout output file (%j expands to jobId)
#SBATCH -N 1                  # Total number of nodes requested
#SBATCH -n 2                  # Total number of mpi tasks requested
#SBATCH -t 24:00:00           # Run time (hh:mm:ss)
#SBATCH -p gpu --gres=gpu:1
#SBATCH --mem=100G

unset LD_LIBRARY_PATH
module --ignore_cache "load python/3.11.0s-ixrhc3q"
module load imagemagick
source /users/zyiqun/.pyenv/versions/miniconda3-3.12-25.1.1-2/envs/swin/bin/activate
nvidia-smi

python -m torch.distributed.launch --nproc_per_node 1 --master_port 12345  main.py \
--cfg configs/swin/swin_base_patch4_window7_224.yaml --batch-size 64 --output ./output/swin_base_patch4_window7_224 \